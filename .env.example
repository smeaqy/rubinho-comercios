# Rubinho Comércios — variáveis de ambiente
# Copie para `.env.local` (desenvolvimento) ou configure na Vercel (produção).

# Senha de acesso ao painel /admin
ADMIN_PASSWORD=

# Chave para assinar o cookie de sessão (32+ caracteres)
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=

# Preenchida automaticamente ao conectar um Blob Store ao projeto
BLOB_READ_WRITE_TOKEN=
